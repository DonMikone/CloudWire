    "Whole connection" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesamte Verbindung"
          }
        }
      }
    },
    "Without the menu bar icon, only the background service runs; open CloudWire from the Applications folder to change settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Menüleistensymbol läuft nur der Hintergrunddienst; öffne CloudWire aus dem Programme-Ordner, um Einstellungen zu ändern."
          }
        }
      }
    },
    "Wrong password" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falsches Passwort"
          }
        }
      }
    },
    "XXXX-XXXX-…" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "XXXX-XXXX-…"
          }
        }
      }
    },
    "You can also do this later in the Connections section." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das geht auch später im Bereich Verbindungen."
          }
        }
      }
    },
    "You can close this window; the job continues in the background." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst dieses Fenster schließen; der Auftrag läuft im Hintergrund weiter."
          }
        }
      }
    },
    "You get a one-time Recovery Key next. Without the password or the Recovery Key the data cannot be recovered." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als Nächstes erhältst du einen einmaligen Wiederherstellungsschlüssel. Ohne Passwort oder Wiederherstellungsschlüssel lassen sich die Daten nicht wiederherstellen."
          }
        }
      }
    },
    "Your browser opens the Nextcloud login. CloudWire only stores an app password, never your account password." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Browser öffnet die Nextcloud-Anmeldung. CloudWire speichert nur ein App-Passwort, nie dein Kontopasswort."
          }
        }
      }
    },
    "Your cloud, wired to your Mac." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Cloud, verkabelt mit deinem Mac."
          }
        }
      }
    },
    "Your cloud, wired to your Mac. Stream everything, keep what matters offline at SSD speed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Cloud, verkabelt mit deinem Mac. Alles streamen, Wichtiges offline mit SSD-Geschwindigkeit."
          }
        }
      }
    },
    "Your First Connection" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine erste Verbindung"
          }
        }
      }
    },
    "Your Recovery Key" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Wiederherstellungsschlüssel"
          }
        }
      }
    },
    "“%@” is required." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist erforderlich."
          }
        }
      }
    },
    "“%@” must be a duration such as 30s, 5m, 1h30m or off." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ muss eine Dauer sein, z. B. 30s, 5m, 1h30m oder off."
          }
        }
      }
    },
    "“%@” must be a number." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ muss eine Zahl sein."
          }
        }
      }
    },
    "“%@” must be a size such as 100M, 20G or off." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ muss eine Größe sein, z. B. 100M, 20G oder off."
          }
        }
      }
    },
    "“%@” must be a whole number." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ muss eine ganze Zahl sein."
          }
        }
      }
    },
    "“%@” must be one of the listed values." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ muss einer der aufgeführten Werte sein."
          }
        }
      }
    },
    "“%@” must be true or false." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ muss true oder false sein."
          }
        }
