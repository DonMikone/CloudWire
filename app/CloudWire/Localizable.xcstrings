    "CloudWire %@ is available" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CloudWire %@ ist verfügbar"
          }
        }
      }
    },
    "CloudWire %@ is available (you have %@)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CloudWire %1$@ ist verfügbar (installiert: %2$@)."
          }
        }
      }
    },
    "CloudWire can merge the existing files with the cloud; for files present on both sides the newer version wins." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CloudWire kann die vorhandenen Dateien mit der Cloud zusammenführen; bei Dateien, die auf beiden Seiten existieren, gewinnt die neuere Version."
          }
        }
      }
    },
    "CloudWire can reach “%@”." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CloudWire erreicht „%@“."
          }
        }
      }
    },
    "CloudWire error" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CloudWire-Fehler"
          }
        }
      }
    },
    "CloudWire forgets the Vault and its stored password. The encrypted data stays in the cloud and can be opened again with the password." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CloudWire vergisst den Tresor und sein gespeichertes Passwort. Die verschlüsselten Daten bleiben in der Cloud und lassen sich mit dem Passwort wieder öffnen."
          }
        }
      }
    },
    "CloudWire forgets this account. Files in the cloud are not touched." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CloudWire vergisst dieses Konto. Dateien in der Cloud bleiben unberührt."
          }
        }
      }
    },
    "CloudWire is open source under the MIT license." : {
      "localizations" : {
